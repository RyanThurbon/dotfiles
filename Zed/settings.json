{
    "minimap": {
        "show": "always",
    },
    "buffer_font_fallbacks": ["Consolas", "Courier New"],
    "icon_theme": {
        "mode": "dark",
        "light": "VSCode Icons for Zed (Light)",
        "dark": "VSCode Icons for Zed (Dark)",
    },
    "toolbar": {
      "breadcrumbs": false,
      "quick_actions": false
    },
    "preferred_line_length": 120,
    "soft_wrap": "prefer_line",
    "git_panel": {
        "dock": "right",
        "tree_view": false,
    },
    "outline_panel": {
        "indent_size": 20.0,
    },
    "disable_ai": true,
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
    },
    "diagnostics": {
        "include_warnings": true,
        "inline": {
            "enabled": true,
        },
    },
    "session": {
        "trust_all_worktrees": true,
        "restore_unsaved_buffers": true,
    },
    "base_keymap": "VSCode",
    "buffer_font_size": 16.0,
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_features": {
        "calt": false,
    },
    "theme": {
        "mode": "dark",
        "light": "Ayu Light",
        "dark": "Ayu Mirage",
    },
    "indent_guides": {
        "enabled": true,
    },
    "formatter": "auto",
    "format_on_save": "off",
    "project_panel": {
        "folder_indicator": "chevron",
        "dock": "left",
        "indent_guides": {
            "show": "always",
        },
        "indent_size": 15.0,
        "auto_fold_dirs": false,
        "git_status": true,
        "git_status_indicator": false,
    },
    "tab_size": 4,
    "languages": {
        "TypeScript": {
            "language_servers": ["typescript-language-server", "!vtsls"],
        },
        "TSX": {
            "language_servers": ["typescript-language-server", "tailwindcss-language-server", "!vtsls"],
        },
        "JavaScript": {
            "language_servers": ["typescript-language-server", "!vtsls"],
        },
    },
    "lsp": {
        "tailwindcss-language-server": {
            "settings": {
                "classFunctions": ["cva", "cx", "clsx"],
            },
        },
    },
}
