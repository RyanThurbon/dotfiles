          "string.regex": { "color": "#9FDA81" },
          "string.special": { "color": "#CE9178" },
          "string.special.symbol": { "color": "#C7988B" },

          "tag": { "color": "#56C9A2" },
          "text.literal": { "color": "#C7988B" },
          "title": { "color": "#56C9A2" },

          "type": { "color": "#56C9A2" },
          "type.builtin": { "color": "#609FD2" },
          "type.class": { "color": "#56C9A2" },
          "type.interface": { "color": "#33C9C5" },
          "type.parameter": { "color": "#3CC4E1" },

          "variable": { "color": "#CCCCCC" },
          "variable.builtin": { "color": "#569CD6" },
          "variable.special": { "color": "#609FD2" },
          "variable.parameter": { "color": "#B2DDC1" },

          "variant": { "color": "#B5CEA8" },
          "delimiter": { "color": "#bbbebf" }
