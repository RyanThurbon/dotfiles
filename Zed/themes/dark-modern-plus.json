		"syntax": {
          "attribute": { "color": "#ABD8F3" },
          "boolean": { "color": "#DEB684" },
          "comment": { "color": "#798090" },
          "comment.doc": { "color": "#798090", "font_style": "italic" },
          "constant": { "color": "#DEB684" },
          "constant.builtin": { "color": "#DEB684" },
          "embedded": { "color": "#CCCCCC" },
          "emphasis": { "color": "#C586C0", "font_style": "italic" },
          "emphasis.strong": { "color": "#569CD6", "font_weight": 700 },
          "function": { "color": "#DCD2A5" },
          "function.special": { "color": "#CCCCCC" },
          "hint": { "color": "#F44747" },

          "keyword": { "color": "#609FD2" },
          "keyword.control": { "color": "#C586C0" },

          "label": { "color": "#CCCCCC" },
          "link_text": { "color": "#3794ff" },
          "link_uri": { "color": "#3794ff" },
          "number": { "color": "#B5CEA8" },
          "operator": { "color": "#CCCCCC" },
          "preproc": { "color": "#D48AAD" },

          "property": { "color": "#9CDCFE" },
          "property.field": { "color": "#ABD8F3" },

          "punctuation": { "color": "#bbbebf" },
          "punctuation.bracket": { "color": "#bbbebf" },
